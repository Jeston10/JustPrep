# Copy to .env.local. Never commit real values. All variables are validated in config/env.ts at boot.
# Free-tier sign-up notes are in docs/TECH_STACK.md.

# ── Firebase (server: service account; Spark plan) ─────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Single line, keep the \n escapes exactly as exported from the JSON key.
FIREBASE_PRIVATE_KEY=

# ── Firebase (client; public by design, restricted by Firestore rules + Auth domains)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── LLM providers (free tiers) ─────────────────────────────────────────────────
GEMINI_API_KEY=            # Google AI Studio
GROQ_API_KEY=              # Groq console (fallback)
OLLAMA_BASE_URL=http://localhost:11434   # local dev only, optional

# ── Rate limiting / quotas (Upstash Redis free tier) ───────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Object storage (Cloudflare R2, S3-compatible; or Supabase Storage) ─────────
STORAGE_PROVIDER=r2        # r2 | supabase
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
NEXT_PUBLIC_STORAGE_PUBLIC_URL=   # public bucket domain for images/audio (also added to CSP)

# ── Observability ──────────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Email (Resend free tier) ───────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=JustPrep <no-reply@your-domain>

# ── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=               # random 32+ bytes; used by GitHub Actions cron → /api/cron/*
SESSION_COOKIE_NAME=session   # becomes __Host-session in production automatically
SKIP_ENV_VALIDATION=       # set to 1 only in CI build steps that lack secrets
