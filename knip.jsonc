{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  // Referenced by name through FlatCompat in eslint.config.mjs; knip cannot see string extends.
  "ignoreDependencies": ["eslint-config-next"],
  // Added in P0.5 (vitest.config.ts, playwright.config.ts); remove this entry in that PR.
  "ignoreBinaries": ["vitest", "playwright"],
}
