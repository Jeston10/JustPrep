    "next": "16.4.3",
    "pino": "^10.3.1",
    "posthog-js": "^1.438.21",
    "posthog-node": "^5.57.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-icons": "^5.5.0",
    "recharts": "^3.0.2",
    "server-only": "^0.0.1",
    "sonner": "^2.0.5",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@size-limit/file": "^14.0.0",
    "@tailwindcss/postcss": "^4",
