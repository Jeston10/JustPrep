{
  "name": "jestons_interview_preparation",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "audit": "pnpm audit --audit-level=high",
    "prepare": "lefthook install",
    "dev:emulators": "cross-env NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 firebase emulators:exec --only auth,firestore --project demo-justprep \"pnpm seed:emulators && next dev\"",
    "seed:emulators": "tsx scripts/seed-emulator.ts",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-justprep",
    "ops:revoke-all-sessions": "tsx scripts/revoke-all-sessions.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.105",
    "@hookform/resolvers": "^5.9.1",
